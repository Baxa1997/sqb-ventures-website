# ---------- Website ----------
# Public URL of the site: canonical links, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the "Founder Account" links point (the cabinet is a separate app).
NEXT_PUBLIC_FOUNDER_ACCOUNT_URL=/account/login

# ---------- ucode platform (server only — never exposed to the browser) ----------
# Without UCODE_API_KEY the site shows the sample content and the forms run in demo mode.
UCODE_BASE_URL=https://api.client.u-code.io
UCODE_API_KEY=
# Optional, only for projects with several resources or environments:
UCODE_PROJECT_ID=
UCODE_RESOURCE_ID=
UCODE_ENVIRONMENT_ID=
# Folder in ucode Files for uploaded pitch decks.
UCODE_DECKS_FOLDER=PitchDecks
# Request timeout (ms) and how long content is cached before it is read again (s).
UCODE_TIMEOUT_MS=15000
UCODE_REVALIDATE_SECONDS=300

# Table slugs, if yours differ from the defaults:
# UCODE_TABLE_APPLICATIONS=applications
# UCODE_TABLE_PARTNER_REQUESTS=partner_requests
# UCODE_TABLE_PORTFOLIO=portfolio
# UCODE_TABLE_NEWS=news
# UCODE_TABLE_TEAM=team
# UCODE_TABLE_PAGES=pages

# Shared secret for POST /api/revalidate (header x-revalidate-secret), called by ucode after edits.
# Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=
