# Public URL of the site, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API for the Pitch Us application and the partner request forms.
# Leave empty to run the forms in demo mode (nothing leaves the browser).
NEXT_PUBLIC_API_URL=

# Where the "Founder Account" links point (the cabinet is a separate app).
NEXT_PUBLIC_FOUNDER_ACCOUNT_URL=/account/login
